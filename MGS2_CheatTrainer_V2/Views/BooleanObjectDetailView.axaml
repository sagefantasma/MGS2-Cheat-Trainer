<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MGS2_CheatTrainer_V2.Views.BooleanObjectDetailView">
    
    <Border BorderThickness="2" BorderBrush="GhostWhite" Margin="3">
    <Grid RowDefinitions="1*"
          ColumnDefinitions="0.5*, 0.5*">
        <!-- Image placeholder (top-left) -->
        <Image x:Name="ObjectImage" Source="/Assets/ration_alp_ovl.bmp.bmp" Stretch="Uniform" Grid.Row="0" Grid.Column="0"
                Margin="4"/>

        <!-- Enabled checkbox (top-right) -->
        <CheckBox Grid.Row="0" Grid.Column="1"
                  x:Name="EnabledCheckBox"
                  Content="Enabled?"
                  Margin="6"
                  VerticalAlignment="Center"
                  IsCheckedChanged="Enabled_OnClick"/>

    </Grid></Border>
    
</UserControl>