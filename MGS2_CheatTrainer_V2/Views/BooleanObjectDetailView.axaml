<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MGS2_CheatTrainer_V2.Views.BooleanObjectDetailView">
    
    <GroupBox x:Name="GroupBox">
        <Grid RowDefinitions="1*"
              ColumnDefinitions="1*">
            <!-- Image placeholder (top-left) -->
            <Image x:Name="ObjectImage" Source="/Assets/ration_alp_ovl.bmp.bmp" Stretch="Uniform" Grid.Row="0" Grid.Column="0"
                   Margin="2" />
            <Rectangle Fill="Black" Opacity="0.7" IsHitTestVisible="False"
                       Grid.Row="0" Grid.Column="0"/>

            <!-- Enabled checkbox (top-right) -->
            <CheckBox Grid.Row="0" Grid.Column="0"
                      x:Name="EnabledCheckBox"
                      Content="Enabled?"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      IsCheckedChanged="Enabled_OnClick"/>
        </Grid>
    </GroupBox>
    
</UserControl>