<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="300"
             x:Class="MGS2_CheatTrainer_V2.Views.BossDetailView">
    
    <Border BorderThickness="2" BorderBrush="GhostWhite" Margin="3">
        <Grid RowDefinitions="0.25*, 0.25*, 0.25*, 0.25*"
              ColumnDefinitions="0.5*, 0.5*">
            <!-- Image placeholder (top-left) -->
            <Image x:Name="ObjectImage" Source="/Assets/ration_alp_ovl.bmp.bmp" Stretch="Uniform" Grid.Row="0" Grid.Column="0" 
                   Grid.ColumnSpan="2" Grid.RowSpan="2" Margin="4"/>
            <TextBlock Margin="35,0,0,0" Text="HP" Grid.Row="2" Grid.Column="0"/>
            <Slider x:Name="HpSlider" Margin="10,0" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"/>
            <TextBlock Margin="35,0,0,0" Text="Stamina" Grid.Row="3" Grid.Column="0"/>
            <Slider x:Name="StaminaSlider" Margin="10,0" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"/>
        </Grid>
    </Border>
</UserControl>
