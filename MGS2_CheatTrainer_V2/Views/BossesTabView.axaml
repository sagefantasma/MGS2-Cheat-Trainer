<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:MGS2_CheatTrainer_V2.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MGS2_CheatTrainer_V2.Views.BossesTabView">
    <Grid x:Name="BossGrid" ColumnDefinitions=".33*,.33*,.33*" RowDefinitions=".33*,.33*,.33*">
        <GroupBox Grid.Row="0" Grid.Column="0" Header="Olga" Margin="5">
            <views:BossDetailView x:Name="OlgaDetailView"  EntityImage="/Assets/Olga.webp"/>
        </GroupBox>
        <GroupBox Grid.Row="0" Grid.Column="1" Header="Fatman" Margin="5">
            <views:BossDetailView x:Name="FatmanDetailView" EntityImage="/Assets/Fatman.webp"/>
        </GroupBox>
        <GroupBox Grid.Row="0" Grid.Column="2" Header="Fortune" Margin="5" IsEnabled="False">
            <views:BossDetailView x:Name="FortuneDetailView" EntityImage="/Assets/Fortune.webp"/>
        </GroupBox>
        <GroupBox Grid.Row="1" Grid.Column="0" Header="Harrier" Margin="5" IsEnabled="False">
            <views:BossDetailView x:Name="HarrierDetailView" EntityImage="/Assets/Harrier.webp" HasStamina="False"/> <!--Need different-->
        </GroupBox>
        <GroupBox Grid.Row="1" Grid.Column="1" Header="Vamp 1" Margin="5">
            <views:BossDetailView x:Name="Vamp1DetailView" EntityImage="/Assets/Vamp.jpg"/>
        </GroupBox>
        <GroupBox Grid.Row="1" Grid.Column="2" Header="Vamp 2" Margin="5">
            <views:BossDetailView x:Name="Vamp2DetailView" EntityImage="/Assets/TwilightSniping.jpg"/>
        </GroupBox>
        <GroupBox Grid.Row="2" Grid.Column="0" Header="RAYs" Margin="5">
            <views:BossDetailView x:Name="RaysDetailView" EntityImage="/Assets/Rays.jpg" HasStamina="False"/> <!--Need different-->
        </GroupBox>
        <GroupBox Grid.Row="2" Grid.Column="1" Header="Solidus" Margin="5" IsEnabled="False">
            <views:BossDetailView x:Name="SolidusDetailView" EntityImage="/Assets/Solidus.webp"/>
        </GroupBox>
    </Grid>
</UserControl>
