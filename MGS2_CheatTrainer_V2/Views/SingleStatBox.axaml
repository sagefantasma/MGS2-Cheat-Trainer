<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="200"
             x:Class="MGS2_CheatTrainer_V2.Views.SingleStatBox">
    <GroupBox x:Name="GroupBox" Header="Stat">
        <Grid ColumnDefinitions="1*" RowDefinitions=".50*, .50*">
            <TextBox x:Name="ValueTextBox" Grid.Row="0" Text="N/A" Margin="0,0,0,5"
                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            <Button x:Name="SetButton" Grid.Row="1" Content="Button" HorizontalAlignment="Stretch" Click="SetButton_OnClick"
                    VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
        </Grid>
    </GroupBox>
</UserControl>
