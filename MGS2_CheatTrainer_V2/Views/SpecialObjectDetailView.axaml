<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MGS2_CheatTrainer_V2.Views.SpecialObjectDetailView">
    
    <Border BorderThickness="2" BorderBrush="Black" Margin="3">
        <Grid x:Name="ItemGrid" ColumnDefinitions=".5*,.5*" RowDefinitions=".5*,.5*">
            <Image x:Name="ObjectImage" Source="/Assets/avalonia-logo.ico" Stretch="UniformToFill" Grid.Row="0" Grid.Column="0" Margin="4"/>
            <CheckBox Grid.Row="0" Grid.Column="1" Content="Enabled" Foreground="Black" Margin="4" Click="Enabled_OnClick"/>
            <Button Grid.Row="1" Grid.Column="0" Content="Modify Value" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black" Margin="4" Click="ModifyValue_OnClick"/>
        </Grid>
    </Border>
    
</UserControl>