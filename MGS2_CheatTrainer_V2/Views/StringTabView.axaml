<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MGS2_CheatTrainer_V2.Views.StringTabView">
    <Grid ColumnDefinitions=".5*,.5*" RowDefinitions=".5*,.5*">
        <ListBox Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" 
                 x:Name="StringListBox" SelectionChanged="SelectingItemsControl_OnSelectionChanged"/>
        <TextBox Grid.Column="1" Grid.Row="0" x:Name="InputTextBox" IsEnabled="False"
                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
        <Button Grid.Column="1" Grid.Row="1" x:Name="UpdateStringButton" IsEnabled="False" Content="Update Game String" 
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                Click="UpdateStringButton_OnClick"/>
    </Grid>
</UserControl>
